# Development: npm run dev uses SQLite without these values.
NODE_ENV=production
PORT=3000
# Exact HTTPS origin, no trailing slash. Required in production.
APP_ORIGIN=https://sumi.example.com
# Set in your deployment secret manager. Never commit real values.
DATABASE_URL=
# Docker Compose requires this to be explicitly set in your environment.
POSTGRES_PASSWORD=
# Set only behind exactly this many trusted reverse proxy hops.
TRUST_PROXY_HOPS=1
# Run migrations explicitly before deploy. Development migrates automatically.
AUTO_MIGRATE=false
# Optional, single-instance persistent-disk alternative. Never use an ephemeral disk.
ALLOW_SQLITE=false
SQLITE_PATH=.data/sumi.sqlite
